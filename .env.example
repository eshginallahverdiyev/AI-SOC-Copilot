# Copy to .env (never commit the real file).
# Only non-secret runtime settings live here: API keys are stored in n8n's
# encrypted credential store, not in environment variables.

GENERIC_TIMEZONE=Asia/Baku
TZ=Asia/Baku

# Public URL n8n uses to build webhook URLs. If Wazuh runs in a VM, use an
# address of the Docker host that the VM can reach, e.g. http://192.168.177.1:5678/
WEBHOOK_URL=http://localhost:5678/

# Keep this stable: it encrypts the credentials stored by n8n.
# Generate one with:  openssl rand -hex 24
N8N_ENCRYPTION_KEY=change-me
