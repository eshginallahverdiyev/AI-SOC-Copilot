      "id": "a1111111-0000-4000-8000-000000000001",
      "name": "Gmail Trigger",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.3,
      "position": [0, 0]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const m = $json;\n\n// --- Sender & subject ---\nlet sender = 'Unknown';\nif (m.from && m.from.value && m.from.value[0]) {\n  sender = m.from.value[0].address || 'Unknown';\n} else if (typeof m.from === 'string') {\n  sender = m.from;\n}\nconst subject = m.subject || '(no subject)';\n\n// --- Body ---\nconst body = (m.text || '') + '\\n' + (m.html || '');\n\n// --- Hostname without URL() ---\nconst getHost = (u) => u.replace(/^https?:\\/\\//i, '').split(/[\\/?#:]/)[0].toLowerCase();\n\n// --- URLs ---\nconst rawUrls = body.match(/https?:\\/\\/[^\\s\"'<>)\\]]+/gi) || [];\nconst ignoreHosts = ['w3.org', 'google.com', 'gstatic.com', 'googleapis.com', 'googleusercontent.com', 'schemas.microsoft.com'];\nconst urls = [...new Set(rawUrls.map(u => u.replace(/[.,;:!?]+$/, '')))].filter(u => {\n  const h = getHost(u);\n  return h && !ignoreHosts.some(i => h === i || h.endsWith('.' + i));\n});\n\n// --- Domains ---\nconst domains = [...new Set(urls.map(getHost))];\n\n// --- IPs (IPv4) ---\nconst ipMatches = body.match(/\\b(?:(?:25[0-5]|2[0-4]\\d|1?\\d?\\d)\\.){3}(?:25[0-5]|2[0-4]\\d|1?\\d?\\d)\\b/g) || [];\nconst ips = [...new Set(ipMatches)].filter(ip => !/^(10\\.|127\\.|192\\.168\\.|172\\.(1[6-9]|2\\d|3[01])\\.|0\\.)/.test(ip));\n\n// --- Attachments ---\nconst binary = $input.item.binary || {};\nconst attachments = Object.keys(binary).map(k => ({\n  key: k,\n  fileName: binary[k].fileName || k,\n  mimeType: binary[k].mimeType || 'unknown'\n}));\n\nreturn {\n  json: {\n    messageId: m.id || null,\n    sender,\n    subject,\n    date: m.date || null,\n    bodyText: (m.text || '').slice(0, 4000),\n    urls,\n    urlCount: urls.length,\n    domains,\n    ips,\n    ipCount: ips.length,\n    attachments,\n    attachmentCount: attachments.length\n  },\n  binary: $input.item.binary\n};"
      },
      "id": "a1111111-0000-4000-8000-000000000002",
      "name": "Extract IOCs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [260, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1111111-0000-4000-8000-000000000003",
              "leftValue": "={{ $json.urlCount }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1111111-0000-4000-8000-000000000004",
      "name": "Has URLs?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [520, 0]
    },
    {
      "parameters": {
        "jsCode": "const e = $input.first().json;\nconst list = (e.urls || []).slice(0, 3);\nreturn list.map(url => ({ json: { url } }));"
      },
      "id": "a2222222-0000-4000-8000-000000000005",
      "name": "Split URLs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [780, -100]
    },
