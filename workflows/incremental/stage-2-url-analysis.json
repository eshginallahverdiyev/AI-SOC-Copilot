        "nodeCredentialType": "urlScanIoApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ url: $json.url, visibility: 'unlisted' }) }}",
        "options": {}
      },
      "id": "a2222222-0000-4000-8000-000000000006",
      "name": "URLScan Submit",
