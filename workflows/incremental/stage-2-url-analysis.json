      "id": "a2222222-0000-4000-8000-000000000012",
      "name": "Merge URL Reports",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [1820, -100]
    },
    {
      "parameters": {
        "jsCode": "const email = $('Extract IOCs').first().json;\nconst us = $('URLScan Report').all().map(i => i.json);\nconst vt = $('VirusTotal Report').all().map(i => i.json);\nconst urls = $('Split URLs').all().map(i => i.json.url);\n\nconst urlResults = urls.map((url, idx) => {\n  const u = us[idx] || {};\n  const v = vt[idx] || {};\n  const attrs = (v.data && v.data.attributes) || {};\n  const stats = attrs.stats || {};\n  const overall = (u.verdicts && u.verdicts.overall) || {};\n  const task = u.task || {};\n  const page = u.page || {};\n  return {\n    url,\n    urlscan: {\n      score: overall.score !== undefined ? overall.score : null,\n      malicious: overall.malicious || false,\n      categories: overall.categories || [],\n      brands: overall.brands || [],\n      reportUrl: task.reportURL || null,\n      screenshot: task.screenshotURL || null,\n      ip: page.ip || null,\n      country: page.country || null\n    },\n    virustotal: {\n      status: attrs.status || null,\n      malicious: stats.malicious || 0,\n      suspicious: stats.suspicious || 0,\n      harmless: stats.harmless || 0,\n      undetected: stats.undetected || 0\n    }\n  };\n});\n\nreturn [{\n  json: {\n    email: {\n      sender: email.sender,\n      subject: email.subject,\n      date: email.date,\n      bodyText: email.bodyText,\n      urls: email.urls,\n      domains: email.domains,\n      ips: email.ips,\n      attachmentCount: email.attachmentCount\n    },\n    urlResults\n  }\n}];"
      },
      "id": "a2222222-0000-4000-8000-000000000013",
      "name": "Summarize URL Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2080, -100]
    }
  ],
